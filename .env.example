# Clerk Dashboard -> Configure -> API keys
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Render PostgreSQL internal connection string
DATABASE_URL=postgresql://user:password@host:5432/database
NODE_ENV=development
PORT=10000

# Optional: HubSpot Private App token (server-side only; never expose to browser)
HUBSPOT_PRIVATE_APP_TOKEN=

# Retell API key with webhook verification enabled
RETELL_API_KEY=
# Clerk user ID for the platform owner (protects admin/agent assignment endpoints)
OWNER_CLERK_USER_ID=
